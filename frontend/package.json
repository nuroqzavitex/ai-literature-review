  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@clerk/testing": "^2.2.28",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.1.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "typescript": "5.8.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
