# ============================================
# AI20K Project — Environment Variables Example
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Job runtime. Use embedded for a single local backend. Docker Compose runs a
# separate worker, so it overrides these as external/api and external/worker.
WORKER_MODE=embedded
RUNTIME_ROLE=api
WORKER_POLL_SECONDS=1
WORKER_MAX_CONCURRENT_JOBS=2
# Redis is optional in local embedded mode. In Docker it is enabled for fast
# worker wake-ups and cached job-status polling; PostgreSQL remains authoritative.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_JOB_STREAM=litreview:jobs
REDIS_JOB_CONSUMER_GROUP=litreview-workers
REDIS_STREAM_BLOCK_MS=1000
WORKER_LEASE_SECONDS=45
WORKER_HEARTBEAT_SECONDS=10
REDIS_STATUS_TTL_SECONDS=30
# Clerk (identity source). Get these values from the Clerk Dashboard.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_SECRET_KEY=sk_test_...
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_signing_secret
# E2E only: an existing Clerk development user, preferably e2e+clerk_test@your-domain.test
# E2E_CLERK_USER_EMAIL=
INVITATION_BASE_URL=http://localhost:3000/

# Resend transactional email (backend-only). Without these values, the app
# still creates a copyable reviewer invitation link.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=Research Review <review@updates.yourdomain.com>
# RESEND_REPLY_TO=team@yourdomain.com
RESEND_TIMEOUT_SECONDS=10
RESEND_MIN_INTERVAL_SECONDS=60

# ---- LLM Configuration ----
# Values: auto, google, openai, ollama, opencode, openrouter.
# auto uses the first fully configured provider in LLM_FALLBACK_ORDER.
# An explicit provider never falls back to a different provider.
LLM_PROVIDER=openai

# Failover only tries providers and keys that are fully configured below.
# Explicit-provider mode may rotate keys, but remains on that provider.
# A successful fallback is used for the rest of the current agent node.
LLM_FAILOVER_ENABLED=true
LLM_FALLBACK_ORDER=google,opencode,ollama,openai,openrouter

# ---- Google Gemini ----
# GOOGLE_API_KEY=your-google-key
# GOOGLE_API_KEYS=key-1,key-2  # Optional rotation pool; never commit real keys
GOOGLE_MODEL=gemini-3.1-flash-lite

# ---- OpenCode Zen (OpenAI-compatible) ----
OPENCODE_HOST=https://opencode.ai/zen/v1
# OPENCODE_API_KEY=your-opencode-key
# OPENCODE_API_KEYS=key-1,key-2  # Optional rotation pool
OPENCODE_MODEL=deepseek-v4-flash-free

# ---- Ollama Cloud ----
OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your-ollama-key
# OLLAMA_API_KEYS=key-1,key-2  # Optional rotation pool
OLLAMA_MODEL=gemma4:31b-cloud

# ---- OpenAI ----
OPENAI_API_KEY=your-openai-key
# OPENAI_API_KEYS=key-1,key-2  # Optional rotation pool
OPENAI_MODEL=gpt-4o

# ---- OpenRouter (OpenAI-compatible) ----
OPENROUTER_HOST=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_API_KEYS=key-1,key-2  # Optional rotation pool
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=LitReview Agent
# ---- Academic Search ----
# Your email address for the OpenAlex polite pool (recommended, not required)
# See: https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication
OPENALEX_EMAIL=your-email@example.com
# OpenAlex authentication key. Keep the actual value only in .env, never commit it.
OPENALEX_API_KEY=
# Semantic Scholar sends the key in the x-api-key request header.
SEMANTIC_SCHOLAR_API_KEY=

# ---- Database ----
# PostgreSQL is the sole system of record for application data and LangGraph checkpoints.
# Docker Compose exposes its PostgreSQL on localhost:5433 by default.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/litreview
POSTGRES_HOST_PORT=5433
# Optional separate PostgreSQL database. Keep this backend-only.
# PRODUCT_DATABASE_URL=postgresql://user:password@localhost:5432/litreview_product
# Frontend-public values also live in this root .env for VPS deploys:
# Local dev: http://localhost:8000/api/v1
# Production: https://c3-app-178.io.vn/api/v1
# Địa chỉ công khai của frontend. BẮT BUỘC đặt khi triển khai thật: canonical,
# ảnh Open Graph và sitemap.xml đều dựng từ giá trị này. Để trống thì mặc định
# là http://localhost:3000, nghĩa là mọi link chia sẻ sẽ trỏ về máy người dùng.
# NEXT_PUBLIC_SITE_URL=https://litreview.example.com
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---- Qdrant Vector Store ----
# Qdrant is a rebuildable semantic index of downloaded paper Markdown. PostgreSQL is
# the source of truth for jobs, reports, reviewer decisions, and evaluations.
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=litreview_papers
# Production uses Gemini embeddings. Set GOOGLE_API_KEY above.
QDRANT_EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
# If Gemini embedding is rate-limited or unavailable, retry the job's semantic
# ranking locally. This uses a separate 384-dimension collection so Gemini
# vectors are never recreated or deleted.
QDRANT_FALLBACK_ENABLED=true
QDRANT_FALLBACK_COLLECTION=litreview_papers_fastembed
QDRANT_FALLBACK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Limit lexical candidates before either provider embeds them. A wider pool
# improves coverage for multi-part questions; final ranking still returns MAX_RESULTS papers.
QDRANT_EMBEDDING_CANDIDATE_LIMIT=40
QDRANT_TIMEOUT=20

# ---- Research Sandbox ----
# Cấu hình local dùng với `docker compose up --build`. Compose tự cấu hình URL
# nội bộ, PostgreSQL, MinIO, volume và runtime image nên không khai báo lại ở đây.
SANDBOX_ENABLED=true
SANDBOX_DEMO_MODE=false
SANDBOX_HYPOTHESIS_ENABLED=true
SANDBOX_GRAPH_OVERLAY_ENABLED=false
SANDBOX_DATA_ANALYSIS_ENABLED=true
SANDBOX_AI_ENABLED=true
SANDBOX_GRAPH_CONTEXT_ENABLED=true
SANDBOX_RESULT_INTERPRETATION_ENABLED=true

# Dùng Project AI thật. Điền OLLAMA_API_KEY và/hoặc GEMINI_API_KEY ở phần LLM.
SANDBOX_PROJECT_AI_FACTORY=sandbox_service.adapters.project_ai:create_project_ai_client
SANDBOX_AI_PROVIDER=auto
SANDBOX_AI_FALLBACK_ORDER=ollama,google
SANDBOX_AI_TIMEOUT_SECONDS=90
SANDBOX_AI_REQUEST_TIMEOUT_SECONDS=180

# Chỉ dùng các giá trị dưới đây cho local development. Shared/staging/production
# phải sinh secret riêng, dài và ngẫu nhiên; tuyệt đối không commit secret thật.
SANDBOX_SERVICE_AUTH_KEY=sandbox-local-compose-service-auth-key-v1
SANDBOX_SERVICE_AUTH_KEY_ID=sandbox-v1
SANDBOX_CONTEXT_SIGNING_KEY=sandbox-local-compose-context-signing-key-v1
SANDBOX_CONTEXT_SIGNING_KEY_ID=sandbox-context-v1
SANDBOX_MANIFEST_SIGNING_KEY=sandbox-local-compose-manifest-signing-key
SANDBOX_POSTGRES_PASSWORD=sandbox-local-only
SANDBOX_MINIO_ROOT_USER=sandbox-minio
SANDBOX_MINIO_ROOT_PASSWORD=sandbox-minio-local-only

# Docker Desktop Windows thường dùng group 0. Trên Linux thay bằng kết quả của:
# stat -c '%g' /var/run/docker.sock
SANDBOX_DOCKER_GID=0

# Runtime mặc định tự ưu tiên Docker. Trên máy Linux không có Docker daemon,
# chạy `sudo bash scripts/setup_sandbox_native.sh`; script sẽ tạo runtime venv
# riêng, cấu hình bubblewrap/prlimit, digest bất biến và đổi launcher thành native.
SANDBOX_RUNTIME_LAUNCHER=auto
# SANDBOX_RUNTIME_PYTHON=/var/lib/research-sandbox/native-runtime/venv/bin/python
# SANDBOX_RUNTIME_SDK_PATH=/var/lib/research-sandbox/native-runtime/sandbox_sdk
# SANDBOX_BWRAP_BINARY=/usr/bin/bwrap
# SANDBOX_CONTROL_URL=http://127.0.0.1:8081
# SANDBOX_WORKER_PROBE_PORT=8090

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Document review PDF parsing ----
# Leave blank to keep uploaded PDFs local and use the pypdf fallback.
# DOCUMENT_REVIEW_LLAMAPARSE_API_KEY=llx-...
DOCUMENT_REVIEW_LLAMAPARSE_TIER=agentic
# Each document-review AI role has its own temperature. Keep critic and
# citation-like decisions deterministic; allow Explain/Rewrite modest range.
DOCUMENT_REVIEW_CRITIC_TEMPERATURE=0.0
DOCUMENT_REVIEW_EXPLAIN_TEMPERATURE=0.3
DOCUMENT_REVIEW_REWRITE_TEMPERATURE=0.5
DOCUMENT_REVIEW_LLM_CALL_TIMEOUT_SECONDS=30
DOCUMENT_REVIEW_CLAIM_TIMEOUT_SECONDS=90
DOCUMENT_REVIEW_CLAIM_CONCURRENCY=2

# Langfuse LLM observability.  Create a project in Langfuse and copy its
# backend-only keys here. Leave both empty to disable remote tracing locally.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log
